# Docker deployment config (copy to .env)
# Can be changed to your own Docker Hub repository; dgddw/artex is used when unset.
ARTEX_IMAGE=dgddw/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (fill in either or both; may also be left empty and configured in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# First-run protection (prevents a remote takeover of the admin account)
# - The web/API port is published on the host's 127.0.0.1 only. To connect from other
#   machines set ARTEX_BIND=0.0.0.0, but finish the initial setup first.
# - On first start a random setup token is printed to the log (docker compose logs artex);
#   enter it on /setup to create the admin password. Setting ARTEX_SETUP_TOKEN makes that
#   value the token and keeps it out of the log.
# - ARTEX_ADMIN_PASSWORD initialises the password directly without /setup (8+ characters).
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
# Browser cross-origin (CORS) allowlist, comma-separated. Leave empty for the embedded UI.
ARTEX_CORS_ORIGINS=
