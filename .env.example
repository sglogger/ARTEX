# Docker deployment config (copy to .env)
# Can be changed to your own Docker Hub repository; dgddw/artex is used when unset.
ARTEX_IMAGE=dgddw/artex
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (fill in either or both; may also be left empty and configured in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
