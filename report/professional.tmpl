<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src data:">
<title>{{.Title}}{{if .Client}} · {{.Client}}{{end}}</title>
<style>
  @page {
    size: A4;
    margin: 22mm 18mm 20mm 18mm;
    @top-left { content: "{{.Title}}"; font: 8pt "Helvetica Neue", Arial, sans-serif; color: #64748b; }
    @top-right { content: "{{.Classification}}"; font: 600 8pt "Helvetica Neue", Arial, sans-serif; color: #b91c1c; text-transform: uppercase; letter-spacing: .06em; }
    @bottom-left { content: "{{.Footer}}"; font: 8pt "Helvetica Neue", Arial, sans-serif; color: #64748b; }
    @bottom-right { content: "{{.L.page}} " counter(page) " {{.L.of}} " counter(pages); font: 8pt "Helvetica Neue", Arial, sans-serif; color: #64748b; }
  }
  @page :first { margin: 0; @top-left { content: none } @top-right { content: none } @bottom-left { content: none } @bottom-right { content: none } }
  :root { --ink: #0f172a; --muted: #64748b; --line: #e2e8f0; --accent: #0f3d5e;
          --critical: #9f1239; --high: #dc2626; --medium: #d97706; --low: #2563eb; --info: #64748b; --none: #15803d; }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { margin: 0; color: var(--ink); background: #fff; font: 10pt/1.5 "Helvetica Neue", Helvetica, Arial, sans-serif; }
  @media screen { body { max-width: 210mm; margin: 0 auto; padding: 16px; } .page-break { margin: 40px 0; border-top: 1px dashed var(--line); } }
  h1, h2, h3, h4, h5, h6 { color: var(--accent); line-height: 1.25; margin: 1.2em 0 .5em; }
  h2.section { font-size: 18pt; border-bottom: 2px solid var(--accent); padding-bottom: 4px; margin-top: 0; }
  h3 { font-size: 13pt; } h4 { font-size: 11pt; } h5, h6 { font-size: 10pt; }
  p { margin: .4em 0 .8em; }
  a { color: var(--accent); }
  .page-break { break-before: page; }
  table { width: 100%; border-collapse: collapse; margin: .6em 0 1em; font-size: 9pt; }
  th, td { border: 1px solid var(--line); padding: 5px 7px; text-align: left; vertical-align: top; }
  th { background: #f1f5f9; font-weight: 600; }
  tr { break-inside: avoid; }
  table.keep { break-inside: avoid; }
  td.nowrap, th.nowrap { white-space: nowrap; }
  pre, code { font-family: "SFMono-Regular", Menlo, Consolas, monospace; font-size: 8pt; }
  pre { background: #f8fafc; border: 1px solid var(--line); border-radius: 4px; padding: 8px; white-space: pre-wrap; word-break: break-word; }
  :not(pre) > code { background: #f1f5f9; padding: 0 3px; border-radius: 3px; }
  blockquote { border-left: 3px solid var(--line); margin: .5em 0; padding: 0 0 0 10px; color: var(--muted); }
  .muted { color: var(--muted); }
  .sev { display: inline-block; min-width: 58px; text-align: center; padding: 1px 8px; border-radius: 10px; color: #fff; font-weight: 600; font-size: 8pt; }
  .sev-critical { background: var(--critical); } .sev-high { background: var(--high); } .sev-medium { background: var(--medium); }
  .sev-low { background: var(--low); } .sev-info { background: var(--info); } .sev-none { background: var(--none); }

  /* cover */
  .cover { height: 296mm; padding: 34mm 24mm 24mm; display: flex; flex-direction: column; background: linear-gradient(160deg, #0f3d5e 0%, #0b2a42 62%, #fff 62.1%); }
  .cover .kicker { color: #93c5fd; text-transform: uppercase; letter-spacing: .18em; font-size: 9pt; font-weight: 600; }
  .cover h1 { color: #fff; font-size: 30pt; margin: 12mm 0 6mm; max-width: 150mm; }
  .cover .client { color: #e2e8f0; font-size: 15pt; }
  .cover .badge { display: inline-block; margin-top: 10mm; border: 1px solid #fca5a5; color: #fecaca; padding: 3px 12px; border-radius: 3px; font-size: 9pt; letter-spacing: .1em; text-transform: uppercase; }
  .cover .meta { margin-top: auto; }
  .cover .meta table { width: 110mm; font-size: 10pt; }
  .cover .meta th { width: 38mm; background: transparent; color: var(--muted); font-weight: 500; border: 0; border-bottom: 1px solid var(--line); }
  .cover .meta td { border: 0; border-bottom: 1px solid var(--line); }

  /* summary */
  .kpis { display: flex; gap: 10px; margin: 1em 0; }
  .kpi { flex: 1; border: 1px solid var(--line); border-radius: 6px; padding: 10px 12px; }
  .kpi .label { color: var(--muted); font-size: 8pt; text-transform: uppercase; letter-spacing: .06em; }
  .kpi .value { font-size: 20pt; font-weight: 700; margin-top: 2px; }
  .bars { margin: .6em 0 1.2em; }
  .bar { display: flex; align-items: center; gap: 10px; margin: 4px 0; }
  .bar .name { width: 70px; font-size: 9pt; }
  .bar .track { flex: 1; height: 12px; background: #f1f5f9; border-radius: 6px; overflow: hidden; }
  .bar .fill { height: 100%; border-radius: 6px; }
  .bar .count { width: 24px; text-align: right; font-weight: 600; font-size: 9pt; }
  .toc ol { padding-left: 1.2em; } .toc li { margin: 3px 0; }

  /* findings */
  .finding { margin-bottom: 1.4em; }
  .finding + .finding { border-top: 2px solid var(--line); padding-top: 1em; margin-top: 1.6em; }
  .finding-head, .finding .meta-table { break-inside: avoid; }
  .finding-head { display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--line); padding-bottom: 6px; break-after: avoid; }
  .finding-head h3 { margin: 0; flex: 1; }
  .finding-head .ref { color: var(--muted); font-weight: 600; font-size: 11pt; }
  .meta-table th { width: 32mm; }
  .note { border-left: 3px solid var(--medium); background: #fffbeb; padding: 4px 10px; font-size: 9pt; }
</style>
</head>
<body>

<section class="cover">
  <div class="kicker">{{.L.default_title}}</div>
  <h1>{{.Title}}</h1>
  {{if .Client}}<div class="client">{{.Client}}</div>{{end}}
  <div><span class="badge">{{.Classification}}</span></div>
  <div class="meta">
    <table>
      {{if .Client}}<tr><th>{{.L.client}}</th><td>{{.Client}}</td></tr>{{end}}
      <tr><th>{{.L.prepared_by}}</th><td>{{.Author}}</td></tr>
      <tr><th>{{.L.date}}</th><td>{{.Date}}</td></tr>
      {{if .Period}}<tr><th>{{.L.period}}</th><td>{{.Period}}</td></tr>{{end}}
      <tr><th>{{.L.classification}}</th><td>{{.Classification}}</td></tr>
    </table>
  </div>
</section>

<section class="page-break toc">
  <h2 class="section">{{.L.toc}}</h2>
  <ol>
    <li><a href="#summary">{{.L.mgmt_summary}}</a></li>
    <li><a href="#scope">{{.L.scope}}</a></li>
    <li><a href="#method">{{.L.methodology}}</a></li>
    <li><a href="#overview">{{.L.overview}}</a></li>
    <li><a href="#details">{{.L.details}}</a></li>
    <li><a href="#disclaimer">{{.L.disclaimer}}</a></li>
  </ol>

  <h2 class="section" id="summary" style="margin-top:14mm">{{.L.mgmt_summary}}</h2>
  <div class="kpis">
    <div class="kpi"><div class="label">{{.L.overall_risk}}</div><div class="value"><span class="sev sev-{{.Risk}}" style="font-size:12pt">{{.RiskLabel}}</span></div></div>
    <div class="kpi"><div class="label">{{.L.findings_total}}</div><div class="value">{{.Total}}</div></div>
    <div class="kpi"><div class="label">{{.L.tasks}}</div><div class="value">{{len .Tasks}}</div></div>
  </div>
  {{if .Summary}}{{.Summary}}{{else}}
    <p>{{.L.auto_summary_1}}</p>
    <p>{{if .Total}}{{printf .L.auto_summary_2 .Total .RiskLabel}}{{else}}{{.L.auto_summary_none}}{{end}}</p>
  {{end}}
  <h4>{{.L.by_severity}}</h4>
  <div class="bars">
    {{range .Severities}}<div class="bar"><span class="name">{{.Label}}</span><span class="track"><span class="fill sev-{{.Key}}" style="display:block;width:{{.Width}}%"></span></span><span class="count">{{.Count}}</span></div>{{end}}
  </div>
  <h4>{{.L.key_findings}}</h4>
  {{if .KeyFindings}}
  <table>
    <tr><th class="nowrap">{{.L.ref}}</th><th>{{.L.title}}</th><th>{{.L.severity}}</th></tr>
    {{range .KeyFindings}}<tr><td class="nowrap">{{.Ref}}</td><td>{{.Title}}</td><td><span class="sev sev-{{.Severity}}">{{.SevLabel}}</span></td></tr>{{end}}
  </table>
  {{else}}<p class="muted">{{.L.no_key_findings}}</p>{{end}}
</section>

<section class="page-break">
  <h2 class="section" id="scope">{{.L.scope}}</h2>
  {{range .Tasks}}
  <h3>{{$.L.task}} #{{.ID}}{{if .Name}} · {{.Name}}{{end}}</h3>
  <table class="meta-table">
    {{if .Description}}<tr><th>{{$.L.description}}</th><td>{{.Description}}</td></tr>{{end}}
    {{if .Goal}}<tr><th>{{$.L.goal}}</th><td style="white-space:pre-wrap">{{.Goal}}</td></tr>{{end}}
    {{if .Scope}}<tr><th>{{$.L.targets}}</th><td>{{range $i, $s := .Scope}}{{if $i}}, {{end}}<code>{{$s}}</code>{{end}}</td></tr>{{end}}
    <tr><th>{{$.L.period}}</th><td>{{.Period}}</td></tr>
    <tr><th>{{$.L.status}}</th><td>{{.Status}}</td></tr>
    <tr><th>{{$.L.findings}}</th><td>{{.Findings}}</td></tr>
  </table>
  {{end}}

</section>

<section class="page-break">
  <h2 class="section" id="method">{{.L.methodology}}</h2>
  <p>{{.L.method_intro}}</p>
  <ol>
    <li>{{.L.phase_recon}}</li>
    <li>{{.L.phase_fp}}</li>
    <li>{{.L.phase_vuln}}</li>
    <li>{{.L.phase_verify}}</li>
    <li>{{.L.phase_report}}</li>
  </ol>
  <h4>{{.L.rating}}</h4>
  <table class="keep">
    <tr><th style="width:30mm">{{.L.severity}}</th><th>{{.L.rating_desc}}</th></tr>
    <tr><td><span class="sev sev-critical">{{.L.sev_critical}}</span></td><td>{{.L.rate_critical}}</td></tr>
    <tr><td><span class="sev sev-high">{{.L.sev_high}}</span></td><td>{{.L.rate_high}}</td></tr>
    <tr><td><span class="sev sev-medium">{{.L.sev_medium}}</span></td><td>{{.L.rate_medium}}</td></tr>
    <tr><td><span class="sev sev-low">{{.L.sev_low}}</span></td><td>{{.L.rate_low}}</td></tr>
    <tr><td><span class="sev sev-info">{{.L.sev_info}}</span></td><td>{{.L.rate_info}}</td></tr>
  </table>
</section>

<section class="page-break">
  <h2 class="section" id="overview">{{.L.overview}}</h2>
  {{if .Findings}}
  <table>
    <tr><th class="nowrap">{{.L.ref}}</th><th>{{.L.title}}</th><th>{{.L.severity}}</th><th>{{.L.status}}</th><th class="nowrap">{{.L.task}}</th></tr>
    {{range .Findings}}<tr><td class="nowrap">{{.Ref}}</td><td>{{.Title}}{{if .Assets}}<br><span class="muted">{{index .Assets 0}}{{if gt (len .Assets) 1}} +{{len .Assets}}{{end}}</span>{{end}}</td><td><span class="sev sev-{{.Severity}}">{{.SevLabel}}</span></td><td>{{.Status}}</td><td class="nowrap">{{.TaskRef}}</td></tr>{{end}}
  </table>
  {{else}}<p class="muted">{{.L.no_findings}}</p>{{end}}
</section>

{{if .Findings}}
<section class="page-break" id="details">
  <h2 class="section">{{.L.details}}</h2>
  {{range .Findings}}
  <article class="finding">
    <div class="finding-head"><span class="ref">{{.Ref}}</span><h3>{{.Title}}</h3><span class="sev sev-{{.Severity}}">{{.SevLabel}}</span></div>
    <table class="meta-table">
      <tr><th>{{$.L.severity}}</th><td>{{.SevLabel}}</td></tr>
      <tr><th>{{$.L.status}}</th><td>{{.Status}}</td></tr>
      {{if .Class}}<tr><th>{{$.L.class}}</th><td>{{.Class}}</td></tr>{{end}}
      {{if .Assets}}<tr><th>{{$.L.assets}}</th><td>{{range $i, $a := .Assets}}{{if $i}}<br>{{end}}<code>{{$a}}</code>{{end}}</td></tr>{{end}}
      {{if .Task}}<tr><th>{{$.L.task}}</th><td>{{.Task}}</td></tr>{{end}}
      <tr><th>{{$.L.found}}</th><td>{{.Found}}</td></tr>
    </table>
    {{if .Merged}}<p class="note">{{printf $.L.merged .Merged}}</p>{{end}}
    {{if .StaleNote}}<p class="note">{{$.L.stale}}</p>{{end}}
    {{if .Summary}}<h4>{{$.L.summary}}</h4><p>{{.Summary}}</p>{{end}}
    {{if .Report}}{{.Report}}{{end}}
    {{if .Evidence}}<h4>{{$.L.evidence}}</h4><pre>{{.Evidence}}</pre>{{end}}
  </article>
  {{end}}
</section>
{{end}}

<section class="page-break">
  <h2 class="section" id="disclaimer">{{.L.disclaimer}}</h2>
  <p>{{.L.disclaimer_text}}</p>
</section>

</body>
</html>
