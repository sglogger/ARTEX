# backend
/data/
*.db
*.db-wal
*.db-shm
config.json
scheduler_state.json
transcripts/
__pycache__/
*.pyc
*.pyo

# frontend
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
*.local

# development tools
/.codegraph/
.playwright-mcp/
.playwright-cli/
.idea/
.vscode/
*.swp
*.swo

# Local logs, backups, and temporary files
*.log
*.bak
*.tmp
*~

# Local documentation must not be published to the repository.
/doc/
/docs/

# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# Single binary artifacts with embedded frontend
/artex
/artex.exe
/artex.exe.*
/artex.*.exe
/artex-*.zip
# Intermediate files one-click update leaves next to the executable (staged file / backup / failed version / upgrade marker)
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime, stored in the project root, never commit)
/jwt.key

# Local environment generated by Docker deployment (contains passwords/keys, do not commit)
.env
.env.*
!.env.example

# Event logs produced by scheduler runs/simulations (test artifacts, do not commit)
*-events.csv

# bench benchmark files (local artifacts, do not commit)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2
