# syntax=docker/dockerfile:1
#
# Local image built entirely from the current checkout (frontend + Go binary + runtime).
# Used by docker-compose.local.yml (Dockerfile.local would be caught by the *.local ignore rule); the release Dockerfile keeps consuming CI-built binaries.
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build

FROM node:22-bookworm-slim AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build:static

FROM golang:1.26-bookworm AS go
WORKDIR /src
COPY go.mod go.sum ./
COPY norma/go.mod norma/go.sum ./norma/
RUN go mod download
COPY . .
COPY --from=web /src/web/out/ ./server/webui/dist/
ARG ARTEX_BUILD_VERSION=local
RUN CGO_ENABLED=0 go build -tags embedui -trimpath \
      -ldflags "-s -w -buildid= -X main.version=${ARTEX_BUILD_VERSION}" \
      -o /out/artex ./cmd/artex

# Runtime: same as the release Dockerfile.
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates ripgrep curl wget vim git jq unzip \
      dnsutils iputils-ping netcat-openbsd inetutils-telnet whois nmap \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g @playwright/mcp@latest @playwright/cli@latest playwright@latest \
    && playwright-cli --help \
    && playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=go /out/artex /app/artex
COPY start.sh /app/start.sh
RUN chmod +x /app/artex /app/start.sh
COPY skills/ /app/skills/
VOLUME ["/app/data"]
EXPOSE 8787 8788
ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787", "-proxy", ":8788"]
